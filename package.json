{
  "name": "finance-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "Production-minded finance dashboard built with Next.js, Supabase, TanStack Query and TypeScript.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "check:e2e": "npm run build && npm run test:e2e"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "npm@10.9.2",
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.1",
    "@tanstack/react-query": "5.103.2",
    "date-fns": "4.1.0",
    "lucide-react": "0.542.0",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5",
    "clsx": "2.1.1",
    "tailwind-merge": "3.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.15.0",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.6",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.2",
    "vitest": "5.0.1",
    "eslint-config-prettier": "^10.1.8"
  }
}
